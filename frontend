import { useEffect, useState } from "react";
import { supabase } from "./supabase";

export default function RecipesPage() {
  const [recipes, setRecipes] = useState([]);

  useEffect(() => {
    supabase.from("recipes")
      .select("*")
      .then(res => setRecipes(res.data));
  }, []);

  return (
    <div>
      {recipes.map(r => (
        <div key={r.id}>
          <h2>{r.name}</h2>
          <p>💰 {r.budget}</p>
        </div>
      ))}
    </div>
  );
}